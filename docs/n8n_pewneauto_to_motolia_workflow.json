{
  "name": "Auto-Scraper PewneAuto.pl -> Motolia.pl Sync",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-node",
      "name": "Manual / Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-node",
      "name": "Daily Schedule (04:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        480
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sync-pewneauto",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger-node",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        660
      ],
      "webhookId": "pewneauto-sync-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "auto_scraper_url",
              "name": "AUTO_SCRAPER_URL",
              "value": "={{ $json.body?.auto_scraper_url || 'http://e00c8s8g8o4cko0wo4o04sws.37.27.193.161.sslip.io' }}",
              "type": "string"
            },
            {
              "id": "motolia_api_url",
              "name": "MOTOLIA_API_URL",
              "value": "={{ $json.body?.motolia_api_url || 'https://api.motolia.pl' }}",
              "type": "string"
            },
            {
              "id": "import_api_key",
              "name": "IMPORT_API_KEY",
              "value": "={{ $json.body?.import_api_key || $env.IMPORT_API_KEY || 'TWOJ_IMPORT_API_KEY' }}",
              "type": "string"
            },
            {
              "id": "source",
              "name": "SOURCE",
              "value": "pewneauto.pl",
              "type": "string"
            },
            {
              "id": "import_mode",
              "name": "IMPORT_MODE",
              "value": "={{ $json.body?.mode || 'merge' }}",
              "type": "string"
            },
            {
              "id": "scrape_limit",
              "name": "SCRAPE_LIMIT",
              "value": "={{ $json.body?.limit || '' }}",
              "type": "string"
            },
            {
              "id": "poll_interval_sec",
              "name": "POLL_INTERVAL_SEC",
              "value": 25,
              "type": "number"
            },
            {
              "id": "max_retries",
              "name": "MAX_RETRIES",
              "value": 120,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "config-parameters-node",
      "name": "Config & Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.AUTO_SCRAPER_URL }}/scrape",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "marketplace",
              "value": "pewneauto"
            },
            {
              "name": "limit",
              "value": "={{ $json.SCRAPE_LIMIT ? $json.SCRAPE_LIMIT : undefined }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "start-scrape-job-node",
      "name": "Start Scrape Job (auto-scraper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log_id_field",
              "name": "log_id",
              "value": "={{ $json.log_id }}",
              "type": "number"
            },
            {
              "id": "retry_count_field",
              "name": "retry_count",
              "value": 0,
              "type": "number"
            },
            {
              "id": "scrape_status_field",
              "name": "status",
              "value": "running",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "init-polling-node",
      "name": "Init Polling State",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        480
      ]
    },
    {
      "parameters": {
        "amount": "={{ $('Config & Parameters').first().json.POLL_INTERVAL_SEC || 25 }}",
        "unit": "seconds"
      },
      "id": "wait-for-scraper-node",
      "name": "Wait (Polling Interval)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        480
      ],
      "webhookId": "scraper-wait-token"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config & Parameters').first().json.AUTO_SCRAPER_URL }}/scrape/status/{{ $json.log_id }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "check-scrape-status-node",
      "name": "Check Scrape Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const statusData = $input.first().json;\nconst previousRetry = $('Wait (Polling Interval)').last()?.json?.retry_count || 0;\nconst newRetry = previousRetry + 1;\nconst maxRetries = $('Config & Parameters').first().json.MAX_RETRIES || 120;\n\nreturn {\n  json: {\n    log_id: statusData.log_id,\n    status: statusData.status,\n    vehicles_scraped: statusData.vehicles_scraped || 0,\n    message: statusData.message || '',\n    error_message: statusData.error_message || null,\n    retry_count: newRetry,\n    timeout_reached: newRetry >= maxRetries\n  }\n};"
      },
      "id": "evaluate-poll-state-node",
      "name": "Evaluate Poll State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is_completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-completed-node",
      "name": "Is Scraping Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is_error",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "is_timeout",
              "leftValue": "={{ $json.timeout_reached }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-error-node",
      "name": "Is Error or Timeout?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        680
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "err_status",
              "name": "status",
              "value": "error",
              "type": "string"
            },
            {
              "id": "err_msg",
              "name": "error",
              "value": "={{ $json.error_message || ($json.timeout_reached ? 'Przekroczono maksymalny czas oczekiwania na scraper (timeout)' : 'Nieznany błąd scrapera') }}",
              "type": "string"
            },
            {
              "id": "err_log_id",
              "name": "log_id",
              "value": "={{ $json.log_id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "error-reporter-node",
      "name": "Report Scraper Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2160,
        780
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config & Parameters').first().json.AUTO_SCRAPER_URL }}/export/json/car-scout",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "pewneauto.pl"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "fetch-scraped-json-node",
      "name": "Fetch Scraped JSON (auto-scraper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2180,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has_vehicles",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "circuit-breaker-node",
      "name": "Circuit Breaker (> 0 aut)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2420,
        460
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "empty_warn",
              "name": "status",
              "value": "warning",
              "type": "string"
            },
            {
              "id": "empty_msg",
              "name": "message",
              "value": "Scraper zakończył pracę, ale nie znaleziono żadnych ofert dla pewneauto.pl. Import pominięty.",
              "type": "string"
            },
            {
              "id": "empty_total",
              "name": "total",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "empty-data-handler-node",
      "name": "Empty Data Notice",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2660,
        640
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config & Parameters').first().json.MOTOLIA_API_URL }}/api/import/csv-data",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config & Parameters').first().json.IMPORT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"{{ $json.source || 'pewneauto.pl' }}\",\n  \"mode\": \"{{ $('Config & Parameters').first().json.IMPORT_MODE || 'merge' }}\",\n  \"data\": {{ JSON.stringify($json.data) }}\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "import-to-motolia-node",
      "name": "Import to Motolia (POST /api/import/csv-data)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
        440
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "report_status",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "report_imported_at",
              "name": "imported_at",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            },
            {
              "id": "report_source",
              "name": "source",
              "value": "pewneauto.pl",
              "type": "string"
            },
            {
              "id": "report_mode",
              "name": "mode",
              "value": "={{ $('Config & Parameters').first().json.IMPORT_MODE || 'merge' }}",
              "type": "string"
            },
            {
              "id": "report_total",
              "name": "totalRows",
              "value": "={{ $json.totalRows }}",
              "type": "number"
            },
            {
              "id": "report_inserted",
              "name": "inserted",
              "value": "={{ $json.inserted }}",
              "type": "number"
            },
            {
              "id": "report_updated",
              "name": "updated",
              "value": "={{ $json.updated }}",
              "type": "number"
            },
            {
              "id": "report_archived",
              "name": "archived",
              "value": "={{ $json.archived }}",
              "type": "number"
            },
            {
              "id": "report_failed",
              "name": "failed",
              "value": "={{ $json.failed }}",
              "type": "number"
            },
            {
              "id": "report_duration",
              "name": "duration_ms",
              "value": "={{ $json.duration }}",
              "type": "number"
            },
            {
              "id": "report_importLogId",
              "name": "importLogId",
              "value": "={{ $json.importLogId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-sync-report-node",
      "name": "Format Sync Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2900,
        440
      ]
    }
  ],
  "connections": {
    "Manual / Test Trigger": {
      "main": [
        [
          {
            "node": "Config & Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Schedule (04:00 AM)": {
      "main": [
        [
          {
            "node": "Config & Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Config & Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config & Parameters": {
      "main": [
        [
          {
            "node": "Start Scrape Job (auto-scraper)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Scrape Job (auto-scraper)": {
      "main": [
        [
          {
            "node": "Init Polling State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init Polling State": {
      "main": [
        [
          {
            "node": "Wait (Polling Interval)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait (Polling Interval)": {
      "main": [
        [
          {
            "node": "Check Scrape Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Scrape Status": {
      "main": [
        [
          {
            "node": "Evaluate Poll State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Poll State": {
      "main": [
        [
          {
            "node": "Is Scraping Completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Scraping Completed?": {
      "main": [
        [
          {
            "node": "Fetch Scraped JSON (auto-scraper)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Is Error or Timeout?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Error or Timeout?": {
      "main": [
        [
          {
            "node": "Report Scraper Error",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait (Polling Interval)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Scraped JSON (auto-scraper)": {
      "main": [
        [
          {
            "node": "Circuit Breaker (> 0 aut)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Circuit Breaker (> 0 aut)": {
      "main": [
        [
          {
            "node": "Import to Motolia (POST /api/import/csv-data)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Empty Data Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Import to Motolia (POST /api/import/csv-data)": {
      "main": [
        [
          {
            "node": "Format Sync Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
