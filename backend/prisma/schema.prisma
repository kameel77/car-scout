generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VehicleSpecification {
  id                       String           @id @default(cuid())
  dealerId                 String?          @map("dealer_id")
  condition                ListingCondition
  brand                    String
  model                    String
  version                  String
  color                    String?
  manufacturingYear        Int?             @map("manufacturing_year")
  enginePowerHp            Int?             @map("engine_power_hp")
  engineCapacityCm3        Int?             @map("engine_capacity_cm3")
  fuelType                 String?          @map("fuel_type")
  transmission             String?
  drive                    String?
  bodyType                 String?          @map("body_type")
  imageUrls                String[]         @map("image_urls")
  specificationPdfUrl      String?          @map("specification_pdf_url")
  equipmentAudioMultimedia String[]         @map("equipment_audio_multimedia")
  equipmentSafety          String[]         @map("equipment_safety")
  equipmentComfortExtras   String[]         @map("equipment_comfort_extras")
  equipmentOther           String[]         @map("equipment_other")
  displayMode              String           @default("ALL") @map("display_mode")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  stockCount               Int              @default(0) @map("stock_count")
  catalogPrice             Int?             @map("catalog_price")
  discountedPrice          Int?             @map("discounted_price")
  isArchived               Boolean          @default(false) @map("is_archived")
  listings                 Listing[]

  @@index([dealerId])
  @@index([isArchived])
  @@index([brand, model, version, color, manufacturingYear])
  @@map("vehicle_specifications")
}

model Listing {
  id                       String                @id @default(cuid())
  listingId                String?               @unique @map("listing_id")
  listingUrl               String?               @map("listing_url")
  scrapedAt                DateTime?             @map("scraped_at")
  make                     String
  model                    String
  version                  String?
  vin                      String?               @unique
  pricePln                 Int                   @map("price_pln")
  priceDisplay             String?               @map("price_display")
  omnibusLowest30dPln      Int?                  @map("omnibus_lowest_30d_pln")
  omnibusText              String?               @map("omnibus_text")
  productionYear           Int                   @map("production_year")
  mileageKm                Int                   @map("mileage_km")
  fuelType                 String?               @map("fuel_type")
  transmission             String?
  enginePowerHp            Int?                  @map("engine_power_hp")
  engineCapacityCm3        Int?                  @map("engine_capacity_cm3")
  drive                    String?
  bodyType                 String?               @map("body_type")
  doors                    Int?
  seats                    Int?
  color                    String?
  paintType                String?               @map("paint_type")
  registrationNumber       String?               @map("registration_number")
  firstRegistrationDate    String?               @map("first_registration_date")
  primaryImageUrl          String?               @map("primary_image_url")
  imageCount               Int?                  @map("image_count")
  imageUrls                String[]              @map("image_urls")
  dealerId                 String?               @map("dealer_id")
  equipmentAudioMultimedia String[]              @map("equipment_audio_multimedia")
  equipmentSafety          String[]              @map("equipment_safety")
  equipmentComfortExtras   String[]              @map("equipment_comfort_extras")
  equipmentOther           String[]              @map("equipment_other")
  additionalInfoHeader     String?               @map("additional_info_header")
  additionalInfoContent    String?               @map("additional_info_content")
  specsJson                Json?                 @map("specs_json")
  isArchived               Boolean               @default(false) @map("is_archived")
  archivedAt               DateTime?             @map("archived_at")
  archivedReason           String?               @map("archived_reason")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  brokerPriceEur           Int?                  @map("broker_price_eur")
  brokerPricePln           Int?                  @map("broker_price_pln")
  dealerPriceNetEur        Float?                @map("dealer_price_net_eur")
  dealerPriceNetPln        Float?                @map("dealer_price_net_pln")
  marketplace              String?               @map("marketplace")
  slug                     String?               @unique @map("slug")
  contactEmail             String?               @map("contact_email")
  contactMode              ContactMode           @default(DEALER_GENERIC) @map("contact_mode")
  contactName              String?               @map("contact_name")
  contactPhoneSnapshot     String?               @map("contact_phone_snapshot")
  importSource             String?               @map("import_source")
  ownerUserId              String?               @map("owner_user_id")
  isFeatured               Boolean               @default(false) @map("is_featured")
  catalogPrice             Int?                  @map("catalog_price")
  condition                ListingCondition      @default(USED)
  entrySource              EntrySource?          @map("entry_source")
  financingPriceBase       FinancingPriceBase    @default(BROKER_PRICE_PLN) @map("financing_price_base")
  isChineseBrand           Boolean               @default(false) @map("is_chinese_brand")
  lastManualEditAt         DateTime?             @map("last_manual_edit_at")
  specificationUrl         String?               @map("specification_url")
  motoliaDiscountPln       Int?                  @map("motolia_discount_pln")
  showMotoliaDiscount      Boolean               @default(false) @map("show_motolia_discount")
  displaySalePrice         Boolean               @default(false) @map("display_sale_price")
  availableForCompany      Boolean               @default(true) @map("available_for_company")
  availableForPrivate      Boolean               @default(true) @map("available_for_private")
  creditAvailable          Boolean               @default(true) @map("credit_available")
  creditProductId          String?               @map("credit_product_id")
  leasingAvailable         Boolean               @default(true) @map("leasing_available")
  leasingProductId         String?               @map("leasing_product_id")
  priceCompanyCreditPln    Int?                  @map("price_company_credit_pln")
  priceCompanyLeasingPln   Int?                  @map("price_company_leasing_pln")
  pricePrivateCreditPln    Int?                  @map("price_private_credit_pln")
  pricePrivateLeasingPln   Int?                  @map("price_private_leasing_pln")
  vatMargin                Boolean               @default(false) @map("vat_margin")
  specificationId          String?               @map("specification_id")
  isRepresentative         Boolean               @default(true) @map("is_representative")
  csflowSourceId           String?               @map("csflow_source_id")
  csflowCarId              Int?                  @map("csflow_car_id")
  leads                    Lead[]
  creditProduct            FinancingProduct?     @relation("ListingCreditProduct", fields: [creditProductId], references: [id])
  dealer                   Dealer?               @relation(fields: [dealerId], references: [id])
  leasingProduct           FinancingProduct?     @relation("ListingLeasingProduct", fields: [leasingProductId], references: [id])
  ownerUser                User?                 @relation("ListingOwner", fields: [ownerUserId], references: [id])
  specification            VehicleSpecification? @relation(fields: [specificationId], references: [id])
  csflowSource             CsflowSource?         @relation(fields: [csflowSourceId], references: [id])
  priceHistory             PriceHistory[]

  @@unique([csflowSourceId, csflowCarId])
  @@index([csflowSourceId])
  @@index([make, model])
  @@index([pricePln])
  @@index([productionYear])
  @@index([isArchived])
  @@index([vin])
  @@index([listingId])
  @@index([marketplace])
  @@index([slug])
  @@index([ownerUserId])
  @@index([isFeatured])
  @@index([condition])
  @@index([isChineseBrand])
  @@index([lastManualEditAt])
  @@index([dealerId, isArchived, createdAt])
  @@map("listings")
}

model Lead {
  id                              String            @id @default(cuid())
  listingId                       String?           @map("listing_id")
  name                            String
  email                           String
  phone                           String?
  preferredContact                String            @default("email") @map("preferred_contact")
  message                         String
  status                          String            @default("new")
  referenceNumber                 String            @unique @map("reference_number")
  consentMarketingAt              DateTime?         @map("consent_marketing_at")
  consentPrivacyAt                DateTime?         @map("consent_privacy_at")
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")
  externalId                      String?           @map("external_id")
  externalStatus                  String?           @map("external_status")
  financingAmount                 Float?            @map("financing_amount")
  financingDownPayment            Float?            @map("financing_down_payment")
  financingInstallment            Float?            @map("financing_installment")
  financingPeriod                 Int?              @map("financing_period")
  financingProductId              String?           @map("financing_product_id")
  financingFinalPayment           Float?            @map("financing_final_payment")
  leadType                        String            @default("sale") @map("lead_type")
  rentalAnnualMileageKm           Int?              @map("rental_annual_mileage_km")
  rentalCompanyName               String?           @map("rental_company_name")
  rentalContractMonths            Int?              @map("rental_contract_months")
  rentalInitialPaymentPct         Float?            @map("rental_initial_payment_pct")
  rentalMonthlyRate               Float?            @map("rental_monthly_rate")
  rentalVehicleId                 String?           @map("rental_vehicle_id")
  rentalInitialPaymentAmountGross Float?            @map("rental_initial_payment_amount_gross")
  rentalInitialPaymentAmountNet   Float?            @map("rental_initial_payment_amount_net")
  financingProduct                FinancingProduct? @relation(fields: [financingProductId], references: [id])
  listing                         Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rentalVehicle                   RentalVehicle?    @relation(fields: [rentalVehicleId], references: [id])

  @@index([listingId])
  @@index([financingProductId])
  @@index([rentalVehicleId])
  @@index([leadType])
  @@map("leads")
}

model Dealer {
  id                  String                 @id @default(cuid())
  name                String
  addressLine1        String                 @map("address_line1")
  addressLine2        String?                @map("address_line2")
  addressLine3        String?                @map("address_line3")
  city                String?
  contactPhone        String?                @map("contact_phone")
  googleRating        Float?                 @map("google_rating")
  googleReviewCount   Int?                   @map("google_review_count")
  googleLink          String?                @map("google_link")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  contactEmail        String?                @map("contact_email")
  contactEmailService String?                @map("contact_email_service")
  csflowDealerId      Int?                   @map("csflow_dealer_id")
  dealerGroupId       String?                @map("dealer_group_id")
  postalCode          String?                @map("postal_code")
  csflowSourceId      String?                @map("csflow_source_id")
  settings            DealerSettings?
  dealerGroup         DealerGroup?           @relation(fields: [dealerGroupId], references: [id])
  csflowSource        CsflowSource?          @relation(fields: [csflowSourceId], references: [id])
  listings            Listing[]
  partnerMappings     PartnerDealerMapping[]
  rentalVehicles      RentalVehicle[]

  @@unique([name, addressLine1])
  @@unique([csflowSourceId, csflowDealerId])
  @@index([dealerGroupId])
  @@map("dealers")
}

model PriceHistory {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  pricePln  Int      @map("price_pln")
  changedAt DateTime @default(now()) @map("changed_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, changedAt])
  @@map("price_history")
}

model ImportLog {
  id         String   @id @default(cuid())
  importedBy String   @map("imported_by")
  fileName   String?  @map("file_name")
  totalRows  Int      @map("total_rows")
  inserted   Int
  updated    Int
  archived   Int
  failed     Int      @default(0)
  status     String
  errorLog   Json?    @map("error_log")
  importedAt DateTime @default(now()) @map("imported_at")
  duration   Int?
  user       User     @relation(fields: [importedBy], references: [id])

  @@index([importedBy])
  @@index([importedAt])
  @@map("import_logs")
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  password             String
  name                 String?
  role                 String       @default("admin")
  isActive             Boolean      @default(true) @map("is_active")
  lastLogin            DateTime?    @map("last_login")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  resetPasswordExpires DateTime?    @map("reset_password_expires")
  resetPasswordToken   String?      @map("reset_password_token")
  importLogs           ImportLog[]
  ownedListings        Listing[]    @relation("ListingOwner")
  memberships          Membership[]

  @@map("users")
}

model AppSettings {
  id                          String   @id @default("default")
  enabledLanguages            String[] @default(["pl"]) @map("enabled_languages")
  displayCurrency             String   @default("PLN") @map("display_currency")
  eurExRate                   Float    @default(4.30) @map("eur_ex_rate")
  brokerFeePctPln             Float    @default(3.5) @map("broker_fee_pct_pln")
  brokerFeePctEur             Float    @default(3.5) @map("broker_fee_pct_eur")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  financingCalculatorEnabled  Boolean  @default(true) @map("financing_calculator_enabled")
  financingCalculatorLocation String   @default("main") @map("financing_calculator_location")
  legalDocuments              Json?    @map("legal_documents")
  legalCompanyName            String?  @map("legal_company_name")
  legalAddress                String?  @map("legal_address")
  legalContactEmail           String?  @map("legal_contact_email")
  legalContactPhone           String?  @map("legal_contact_phone")
  legalVatId                  String?  @map("legal_vat_id")
  legalRegisterNumber         String?  @map("legal_register_number")
  legalRepresentative         String?  @map("legal_representative")
  headerLogoUrl               String?  @map("header_logo_url")
  footerLogoUrl               String?  @map("footer_logo_url")
  legalSloganPl               String?  @map("legal_slogan_pl")
  legalSloganEn               String?  @map("legal_slogan_en")
  legalSloganDe               String?  @map("legal_slogan_de")
  autoRefreshImages           Boolean  @default(false) @map("auto_refresh_images")
  headerLogoTextPl            String?  @map("header_logo_text_pl")
  headerLogoTextEn            String?  @map("header_logo_text_en")
  headerLogoTextDe            String?  @map("header_logo_text_de")
  siteNameDe                  String?  @map("site_name_de")
  siteNameEn                  String?  @map("site_name_en")
  siteNamePl                  String?  @map("site_name_pl")
  defaultOgDescription        String?  @map("default_og_description")
  defaultOgImage              String?  @map("default_og_image")
  defaultOgTitle              String?  @map("default_og_title")
  smtpFromEmail               String?  @map("smtp_from_email")
  smtpHost                    String?  @map("smtp_host")
  smtpPassword                String?  @map("smtp_password")
  smtpPort                    Int?     @map("smtp_port")
  smtpRecipientEmail          String?  @map("smtp_recipient_email")
  smtpUser                    String?  @map("smtp_user")
  featuredModulesVisibility   String[] @default(["nowe", "uzywane", "wynajem"]) @map("featured_modules_visibility")
  navItemsVisibility          String[] @default(["samochody", "wynajem"]) @map("nav_items_visibility")
  negotiatePriceEnabled       Boolean  @default(true) @map("negotiate_price_enabled")
  negotiatePricePosition      String   @default("both") @map("negotiate_price_position")
  csflowEnabled               Boolean  @default(true) @map("csflow_enabled")
  defaultSortCars             String   @default("price_asc") @map("default_sort_cars")
  defaultSortRental           String   @default("minMonthlyRateNet_asc") @map("default_sort_rental")
  searchGridColumns           Int      @default(4) @map("search_grid_columns")
  splitNewUsed                Boolean  @default(false) @map("split_new_used")
  leadRecipientUserId         String?  @map("lead_recipient_user_id")
  salesContactPhone           String?  @map("sales_contact_phone")
  pdfParserLlmModel           String   @default("deepseek/deepseek-v4-flash") @map("pdf_parser_llm_model")
  pdfParserSystemPrompt       String?  @map("pdf_parser_system_prompt")

  @@map("app_settings")
}

model Translation {
  id          String   @id @default(cuid())
  category    String
  sourceValue String   @unique @map("source_value")
  pl          String?
  en          String?
  de          String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("translations")
}

model FaqEntry {
  id            String   @id @default(cuid())
  page          FaqPage
  sortOrder     Int      @default(0) @map("sort_order")
  questionPl    String   @map("question_pl")
  answerPl      String   @map("answer_pl")
  questionEn    String   @map("question_en")
  answerEn      String   @map("answer_en")
  questionDe    String   @map("question_de")
  answerDe      String   @map("answer_de")
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  financingType String?  @map("financing_type")
  pageContext   String   @default("all") @map("page_context")

  @@index([page, sortOrder])
  @@map("faq_entries")
}

model FinancingProduct {
  id                    String           @id @default(cuid())
  category              String
  name                  String?
  currency              String           @default("PLN")
  referenceRate         Float            @map("reference_rate")
  margin                Float
  commission            Float
  maxInitialPayment     Float            @map("max_initial_payment")
  maxFinalPayment       Float            @map("max_final_payment")
  minInstallments       Int              @map("min_installments")
  maxInstallments       Int              @map("max_installments")
  isDefault             Boolean          @default(false) @map("is_default")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  provider              String           @default("OWN")
  priority              Int              @default(0)
  minAmount             Float?           @map("min_amount")
  maxAmount             Float?           @map("max_amount")
  providerConfig        Json?            @map("provider_config")
  hasBalloonPayment     Boolean          @default(true) @map("has_balloon_payment")
  dealerCreditDefaults  DealerSettings[] @relation("DealerDefaultCreditProduct")
  dealerLeasingDefaults DealerSettings[] @relation("DealerDefaultLeasingProduct")
  leads                 Lead[]
  creditListings        Listing[]        @relation("ListingCreditProduct")
  leasingListings       Listing[]        @relation("ListingLeasingProduct")

  @@index([category])
  @@index([isDefault])
  @@map("financing_products")
}

model FinancingProviderConnection {
  id         String   @id @default(cuid())
  provider   String
  name       String
  apiBaseUrl String   @map("api_base_url")
  apiKey     String   @map("api_key")
  apiSecret  String?  @map("api_secret")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  shopUuid   String?  @map("shop_uuid")

  @@index([provider])
  @@index([provider, isActive])
  @@map("financing_provider_connections")
}

model CrmTrackingSession {
  id         String             @id
  uuid       String
  lastSeenAt DateTime           @map("last_seen_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  visits     CrmTrackingVisit[]

  @@index([uuid])
  @@index([uuid, lastSeenAt])
  @@map("crm_tracking_sessions")
}

model CrmTrackingVisit {
  id        String             @id @default(cuid())
  sessionId String             @map("session_id")
  url       String
  visitedAt DateTime           @map("visited_at")
  createdAt DateTime           @default(now()) @map("created_at")
  session   CrmTrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, visitedAt])
  @@map("crm_tracking_visits")
}

model SeoConfig {
  id                   String   @id @default("default")
  gtmId                String?  @map("gtm_id")
  homeTitle            String?  @map("home_title")
  homeDescription      String?  @map("home_description")
  homeOgImage          String?  @map("home_og_image")
  listingTitle         String?  @map("listing_title")
  listingDescription   String?  @map("listing_description")
  updatedAt            DateTime @updatedAt @map("updated_at")
  homeDescriptionDe    String?  @map("home_description_de")
  homeDescriptionEn    String?  @map("home_description_en")
  homeTitleDe          String?  @map("home_title_de")
  homeTitleEn          String?  @map("home_title_en")
  listingDescriptionDe String?  @map("listing_description_de")
  listingDescriptionEn String?  @map("listing_description_en")
  listingTitleDe       String?  @map("listing_title_de")
  listingTitleEn       String?  @map("listing_title_en")

  @@map("seo_config")
}

model PartnerAd {
  id             String   @id @default(cuid())
  placement      String
  title          String?
  description    String?
  subtitle       String?
  ctaText        String?  @map("cta_text")
  url            String
  imageUrl       String?  @map("image_url")
  brandName      String?  @map("brand_name")
  features       String[] @default([])
  priority       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  overlayOpacity Float    @default(0.9) @map("overlay_opacity")
  ctaTextDe      String?  @map("cta_text_de")
  ctaTextEn      String?  @map("cta_text_en")
  descriptionDe  String?  @map("description_de")
  descriptionEn  String?  @map("description_en")
  subtitleDe     String?  @map("subtitle_de")
  subtitleEn     String?  @map("subtitle_en")
  titleDe        String?  @map("title_de")
  titleEn        String?  @map("title_en")
  hideUiElements Boolean  @default(false) @map("hide_ui_elements")
  mobileImageUrl String?  @map("mobile_image_url")
  pageContext    String   @default("all") @map("page_context")

  @@index([placement])
  @@index([isActive])
  @@map("partner_ads")
}

model CsflowSource {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  apiUrl        String       @map("api_url")
  isEnabled     Boolean      @default(true) @map("is_enabled")
  dealerGroupId String?      @map("dealer_group_id")
  lastSyncAt    DateTime?    @map("last_sync_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  dealerGroup   DealerGroup? @relation(fields: [dealerGroupId], references: [id])
  dealers       Dealer[]
  listings      Listing[]

  @@map("csflow_sources")
}

model DealerGroup {
  id            String               @id @default(cuid())
  name          String               @unique
  slug          String               @unique
  contactName   String?              @map("contact_name")
  contactEmail  String?              @map("contact_email")
  contactPhone  String?              @map("contact_phone")
  addressLine1  String?              @map("address_line1")
  city          String?
  nip           String?
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  settings      DealerGroupSettings?
  dealers       Dealer[]
  csflowSources CsflowSource[]

  @@map("dealer_groups")
}

model Membership {
  id               String     @id @default(cuid())
  userId           String     @map("user_id")
  scopeType        ScopeType  @map("scope_type")
  scopeId          String     @map("scope_id")
  role             MemberRole
  isDefaultContext Boolean    @default(false) @map("is_default_context")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId, role])
  @@index([userId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("memberships")
}

model DealerGroupSettings {
  id                 String      @id @default(cuid())
  dealerGroupId      String      @unique @map("dealer_group_id")
  headerLogoUrl      String?     @map("header_logo_url")
  footerLogoUrl      String?     @map("footer_logo_url")
  smtpHost           String?     @map("smtp_host")
  smtpPort           Int?        @map("smtp_port")
  smtpUser           String?     @map("smtp_user")
  smtpPassword       String?     @map("smtp_password")
  smtpFromEmail      String?     @map("smtp_from_email")
  smtpRecipientEmail String?     @map("smtp_recipient_email")
  dealerGroup        DealerGroup @relation(fields: [dealerGroupId], references: [id], onDelete: Cascade)

  @@map("dealer_group_settings")
}

model DealerSettings {
  id                      String            @id @default(cuid())
  dealerId                String            @unique @map("dealer_id")
  headerLogoUrl           String?           @map("header_logo_url")
  footerLogoUrl           String?           @map("footer_logo_url")
  smtpHost                String?           @map("smtp_host")
  smtpPort                Int?              @map("smtp_port")
  smtpUser                String?           @map("smtp_user")
  smtpPassword            String?           @map("smtp_password")
  smtpFromEmail           String?           @map("smtp_from_email")
  smtpRecipientEmail      String?           @map("smtp_recipient_email")
  leadRouting             LeadRouting       @default(MOTOLIA) @map("lead_routing")
  defaultCreditProductId  String?           @map("default_credit_product_id")
  defaultLeasingProductId String?           @map("default_leasing_product_id")
  dealer                  Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  defaultCreditProduct    FinancingProduct? @relation("DealerDefaultCreditProduct", fields: [defaultCreditProductId], references: [id])
  defaultLeasingProduct   FinancingProduct? @relation("DealerDefaultLeasingProduct", fields: [defaultLeasingProductId], references: [id])

  @@map("dealer_settings")
}

model Partner {
  id            String                 @id @default(cuid())
  name          String
  apiKey        String                 @unique @map("api_key")
  nip           String?
  contactPerson String?                @map("contact_person")
  contactEmail  String?                @map("contact_email")
  contactPhone  String?                @map("contact_phone")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  mappings      PartnerDealerMapping[]

  @@index([apiKey])
  @@index([isActive])
  @@map("partners")
}

model PartnerDealerMapping {
  id         String  @id @default(cuid())
  partnerId  String  @map("partner_id")
  dealerId   String  @map("dealer_id")
  externalId String  @map("external_id")
  dealer     Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  partner    Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, dealerId])
  @@unique([partnerId, externalId])
  @@map("partner_dealer_mappings")
}

model RentalVehicle {
  id                       String                    @id @default(cuid())
  dealerId                 String?                   @map("dealer_id")
  make                     String
  model                    String
  version                  String?
  bodyType                 String?                   @map("body_type")
  fuelType                 String?                   @map("fuel_type")
  transmission             String?
  enginePowerHp            Int?                      @map("engine_power_hp")
  engineCapacityCm3        Int?                      @map("engine_capacity_cm3")
  productionYear           Int?                      @map("production_year")
  color                    String?
  paintType                String?                   @map("paint_type")
  doors                    Int?
  seats                    Int?
  drive                    String?
  catalogPrice             Int?                      @map("catalog_price")
  sellingPrice             Int?                      @map("selling_price")
  primaryImageUrl          String?                   @map("primary_image_url")
  imageUrls                String[]                  @map("image_urls")
  equipmentAudioMultimedia String[]                  @map("equipment_audio_multimedia")
  equipmentSafety          String[]                  @map("equipment_safety")
  equipmentComfortExtras   String[]                  @map("equipment_comfort_extras")
  equipmentOther           String[]                  @map("equipment_other")
  additionalInfoHeader     String?                   @map("additional_info_header")
  additionalInfoContent    String?                   @map("additional_info_content")
  specsJson                Json?                     @map("specs_json")
  slug                     String?                   @unique
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  ownerRentalCompanyId     String?                   @map("owner_rental_company_id")
  specificationUrl         String?                   @map("specification_url")
  carClass                 String?                   @map("car_class")
  isFeatured               Boolean                   @default(false) @map("is_featured")
  modelCode                String?                   @map("model_code")
  condition                ListingCondition          @default(NEW) @map("condition")
  firstRegistrationDate    String?                   @map("first_registration_date")
  mileageKm                Int?                      @map("mileage_km")
  registrationNumber       String?                   @map("registration_number")
  vin                      String?                   @map("vin")
  isPublished              Boolean                   @default(true) @map("is_published")
  leads                    Lead[]
  dealer                   Dealer?                   @relation(fields: [dealerId], references: [id])
  ownerRentalCompany       RentalCompany?            @relation("VehicleOwnerCompany", fields: [ownerRentalCompanyId], references: [id])
  rentalAssignments        VehicleRentalAssignment[]

  @@index([dealerId])
  @@index([ownerRentalCompanyId])
  @@index([make, model])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([condition])
  @@index([slug])
  @@map("rental_vehicles")
}

model RentalCompany {
  id                 String                    @id @default(cuid())
  name               String                    @unique
  slug               String?                   @unique
  logoUrl            String?                   @map("logo_url")
  contactEmail       String?                   @map("contact_email")
  contactPhone       String?                   @map("contact_phone")
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  includedServices   String[]                  @default([]) @map("included_services")
  insuranceAddMode   InsuranceAddMode?         @default(INSURANCE_23) @map("insurance_add_mode")
  ownedVehicles      RentalVehicle[]           @relation("VehicleOwnerCompany")
  vehicleAssignments VehicleRentalAssignment[]

  @@map("rental_companies")
}

model VehicleRentalAssignment {
  id                       String              @id @default(cuid())
  vehicleId                String              @map("vehicle_id")
  rentalCompanyId          String              @map("rental_company_id")
  externalVehicleId        String?             @map("external_vehicle_id")
  calculationId            String?             @map("calculation_id")
  isActive                 Boolean             @default(true) @map("is_active")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  includedServicesOverride String[]            @map("included_services_override")
  insuranceAddModeOverride InsuranceAddMode?   @map("insurance_add_mode_override")
  matrixEntries            RentalMatrixEntry[]
  rentalCompany            RentalCompany       @relation(fields: [rentalCompanyId], references: [id])
  vehicle                  RentalVehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, rentalCompanyId])
  @@index([vehicleId])
  @@index([rentalCompanyId])
  @@map("vehicle_rental_assignments")
}

model RentalMatrixEntry {
  id                        String                  @id @default(cuid())
  assignmentId              String                  @map("assignment_id")
  annualMileageKm           Int                     @map("annual_mileage_km")
  contractMonths            Int                     @map("contract_months")
  initialPaymentPct         Float                   @map("initial_payment_pct")
  monthlyRateNet            Float                   @map("monthly_rate_net")
  monthlyRateGross          Float                   @map("monthly_rate_gross")
  servicesIncluded          String[]                @map("services_included")
  createdAt                 DateTime                @default(now()) @map("created_at")
  insuranceExcess500        Float?                  @map("insurance_excess_500")
  insuranceNoLimit          Float?                  @map("insurance_no_limit")
  offerType                 String                  @default("all") @map("offer_type")
  overMileageCost           Float?                  @map("over_mileage_cost")
  tiresNoLimit              Float?                  @map("tires_no_limit")
  initialPaymentAmountGross Float                   @default(0) @map("initial_payment_amount_gross")
  initialPaymentAmountNet   Float                   @default(0) @map("initial_payment_amount_net")
  insuranceNet              Float?                  @map("insurance_net")
  assignment                VehicleRentalAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, annualMileageKm, contractMonths, initialPaymentPct, initialPaymentAmountNet, initialPaymentAmountGross, offerType])
  @@index([assignmentId])
  @@index([monthlyRateGross])
  @@index([assignmentId, monthlyRateGross])
  @@map("rental_matrix_entries")
}

model Widget {
  id             String          @id @default(cuid())
  name           String
  isActive       Boolean         @default(true) @map("is_active")
  placement      WidgetPlacement
  vehicleSources String[]
  selectionMode  SelectionMode   @map("selection_mode")
  filterParams   Json?           @map("filter_params")
  layoutStyle    String          @default("carousel") @map("layout_style")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("widgets")
}

model FeatureTile {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?  @map("image_url")
  targetUrl String   @map("target_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("feature_tiles")
}

model HeroBanner {
  id                 String   @id @default(cuid())
  imageUrlDesktop    String?  @map("image_url_desktop")
  imageUrlMobile     String?  @map("image_url_mobile")
  altText            String   @default("") @map("alt_text")
  buttonLabel        String   @default("") @map("button_label")
  buttonUrl          String   @default("") @map("button_url")
  buttonPositionYPct Int      @default(60) @map("button_position_y_pct")
  buttonAlign        String   @default("left") @map("button_align")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("hero_banners")
}

model ConsentRecord {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at")
  brandId       String?  @map("brand_id")
  ipHash        String   @map("ip_hash")
  userAgent     String   @map("user_agent")
  country       String?
  choice        Json
  bannerVersion String   @map("banner_version")

  @@index([createdAt])
  @@map("consent_records")
}

