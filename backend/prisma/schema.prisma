// >>> PIPELINE MODULE
// ---------- Enums ----------

enum ClientType {
  UNKNOWN
  B2C
  B2B
}

/// Orthogonal to ClientType. The pair (clientType, financingType) replaces the
/// 7-value ProductPath cartesian enum, so a new product is a config row, not a
/// schema migration.
enum FinancingType {
  CASH
  CREDIT
  LEASING
  RENTAL
}

/// Lifecycle, deliberately separate from PipelinePhase so that a lost deal
/// retains the phase it died in. This is the funnel drop-off report.
enum OpportunityStatus {
  OPEN
  WON
  LOST
  NURTURING
}

enum PipelinePhase {
  INBOX
  QUALIFICATION
  SELECTION
  COMPLETING
  FINANCIAL_DECISION
  CONTRACT
  DELIVERY
}

enum PipelineApplicationState {
  DRAFT
  PRECHECK_SUBMITTED
  PRECHECK_APPROVED
  FULL_SUBMITTED
  CONDITIONALLY_APPROVED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum LeadSourceChannel {
  TV
  META
  GOOGLE
  ORGANIC
  REFERRAL
  DEALER
  PARTNER
  OTHER
}

enum PipelineTaxMode {
  GROSS
  NET
}

enum CommissionStatus {
  EXPECTED
  EARNED
  INVOICED
  PAID
  REVERSED
}

enum PipelineDocumentStatus {
  REQUIRED
  REQUESTED
  RECEIVED
  VERIFIED
  WAIVED
}

enum PipelineActorType {
  USER
  SYSTEM
  AUTOMATION
  THULIUM
  CUSTOMER
}

// ---------- Customer ----------

/// Deliberately a first-class entity, not a snapshot on the opportunity.
/// One customer can hold several opportunities in parallel (two cars bought at
/// once) or in sequence (repeat business). Without this table, "what happened
/// with this client" cannot be answered across cases.
/// PESEL is stored encrypted (AES-256-GCM) for financial application submission.
/// ID document scans and numbers are NOT stored. Thulium and financiers remain carriers of document scans.
model PipelineCustomer {
  id                String     @id @default(cuid())
  scopeType         ScopeType  @map("scope_type")
  scopeId           String     @map("scope_id")
  clientType        ClientType @default(UNKNOWN) @map("client_type")
  fullName          String     @map("full_name")
  phone             String?
  email             String?
  companyName       String?    @map("company_name")
  companyNip        String?    @map("company_nip")
  /// Szyfrowany AES-256-GCM. Format: "v1:<iv_b64>:<tag_b64>:<ciphertext_b64>".
  /// NIGDY nie trafia do pipeline_events, pipeline_thulium_dead_letters ani do logów.
  peselEnc          String?    @map("pesel_enc")
  /// Do rozpoznania klienta bez deszyfrowania: 7 gwiazdek + 4 ostatnie cyfry.
  peselMasked       String?    @map("pesel_masked")
  thuliumCustomerId Int?       @map("thulium_customer_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  opportunities PipelineOpportunity[]
  events        PipelineEvent[]

  @@index([scopeType, scopeId])
  @@index([phone])
  @@index([email])
  @@index([thuliumCustomerId])
  @@index([companyNip])
  @@map("pipeline_customers")
}

// ---------- Opportunity ----------

model PipelineOpportunity {
  id        String    @id @default(cuid())
  number    String    @unique
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id")
  brand     String    @default("motolia")

  customerId    String         @map("customer_id")
  clientType    ClientType     @default(UNKNOWN) @map("client_type")
  financingType FinancingType? @map("financing_type")

  status         OpportunityStatus @default(OPEN)
  phase          PipelinePhase     @default(QUALIFICATION)
  phaseEnteredAt DateTime          @default(now()) @map("phase_entered_at")

  /// Attribution. REQUIRED at creation, including for manually created cases —
  /// this is the field that makes "how many contracts did TV produce" answerable.
  leadSource       LeadSourceChannel @map("lead_source")
  leadSourceDetail String?           @map("lead_source_detail")
  firstTouchAt     DateTime          @default(now()) @map("first_touch_at")
  firstContactAt   DateTime?         @map("first_contact_at")

  /// Origin lead from the public site, when the case started there.
  sourceLeadId String? @unique @map("source_lead_id")

  thuliumTicketId Int? @map("thulium_ticket_id")

  ownerUserId     String?   @map("owner_user_id")
  priority        String    @default("NORMAL")
  nextActionType  String?   @map("next_action_type")
  nextActionNote  String?   @map("next_action_note")
  nextActionDueAt DateTime? @map("next_action_due_at")

  contractSignedAt DateTime? @map("contract_signed_at")
  contractedApplicationId String? @map("contracted_application_id")
  deliveredAt      DateTime? @map("delivered_at")

  wonAt          DateTime? @map("won_at")
  lostAt         DateTime? @map("lost_at")
  lostReasonCode String?   @map("lost_reason_code")
  lostComment    String?   @map("lost_comment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer              PipelineCustomer     @relation(fields: [customerId], references: [id])
  sourceLead            Lead?                @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  owner                 User?                @relation("PipelineOpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lostReason            PipelineLossReason?  @relation(fields: [lostReasonCode], references: [code])
  contractedApplication PipelineApplication? @relation("ContractedApplication", fields: [contractedApplicationId], references: [id], onDelete: SetNull)

  vehicleCandidates PipelineVehicleCandidate[]
  offers            PipelineOffer[]
  applications      PipelineApplication[]
  documents         PipelineDocument[]
  tasks             PipelineTask[]
  commissions       PipelineCommission[]
  events            PipelineEvent[]

  @@index([scopeType, scopeId, status, phase])
  @@index([ownerUserId, status])
  @@index([nextActionDueAt])
  @@index([customerId])
  @@index([leadSource, createdAt])
  @@map("pipeline_opportunities")
}

// ---------- Vehicle candidates ----------

/// A shortlist, not a copy of the catalogue. Real FKs keep price and
/// availability current; priceSnapshot only records what was quoted to the
/// client at the time, for dispute resolution.
model PipelineVehicleCandidate {
  id                  String   @id @default(cuid())
  opportunityId       String   @map("opportunity_id")
  listingId           String?  @map("listing_id")
  rentalVehicleId     String?  @map("rental_vehicle_id")
  rentalStockUnitId   String?  @map("rental_stock_unit_id")
  /// Only for cars outside our stock (dealer order, customer-found).
  customMake          String?  @map("custom_make")
  customModel         String?  @map("custom_model")
  customVersion       String?  @map("custom_version")
  customYear          Int?     @map("custom_year")
  priceSnapshotGrosze Int?     @map("price_snapshot_grosze")
  selectionStatus     String   @default("CANDIDATE")
  createdAt           DateTime @default(now()) @map("created_at")

  opportunity     PipelineOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  listing         Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  rentalVehicle   RentalVehicle?      @relation(fields: [rentalVehicleId], references: [id], onDelete: SetNull)
  rentalStockUnit RentalStockUnit?    @relation(fields: [rentalStockUnitId], references: [id], onDelete: SetNull)
  offers          PipelineOffer[]

  @@index([opportunityId])
  @@index([rentalStockUnitId])
  @@map("pipeline_vehicle_candidates")
}

// ---------- Offer ----------

model PipelineOffer {
  id                 String        @id @default(cuid())
  opportunityId      String        @map("opportunity_id")
  vehicleCandidateId String?       @map("vehicle_candidate_id")
  financingProductId String?       @map("financing_product_id")
  versionNumber      Int           @default(1) @map("version_number")
  financingType      FinancingType @map("financing_type")
  status             String        @default("DRAFT")

  priceGrosze        Int             @map("price_grosze")
  downPaymentGrosze  Int             @default(0) @map("down_payment_grosze")
  periodMonths       Int             @map("period_months")
  monthlyRateGrosze  Int             @map("monthly_rate_grosze")
  finalPaymentGrosze Int?            @map("final_payment_grosze")
  annualMileageKm    Int?            @map("annual_mileage_km")
  taxMode            PipelineTaxMode @default(GROSS) @map("tax_mode")
  currency           String          @default("PLN")

  /// Frozen rental matrix variant snapshot
  rentalPriceVariant     String?  @map("rental_price_variant")
  rentalInsuranceVariant Int?     @map("rental_insurance_variant")
  rentalTiresIncluded    Boolean  @default(false) @map("rental_tires_included")

  /// Computed from the commission basis, never typed by hand except as an
  /// explicit override with a reason. See PipelineCommission.
  commissionRatePct        Decimal? @map("commission_rate_pct") @db.Decimal(6, 3)
  expectedCommissionGrosze Int?     @map("expected_commission_grosze")

  presentedAt DateTime? @map("presented_at")
  validUntil  DateTime? @map("valid_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  opportunity      PipelineOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  vehicleCandidate PipelineVehicleCandidate? @relation(fields: [vehicleCandidateId], references: [id], onDelete: SetNull)
  financingProduct FinancingProduct?         @relation(fields: [financingProductId], references: [id], onDelete: SetNull)
  applications     PipelineApplication[]

  @@unique([opportunityId, versionNumber])
  @@index([opportunityId])
  @@map("pipeline_offers")
}

// ---------- Financier ----------

/// The entity the previous plan was missing. Enables the financier
/// recommender: hard-criteria filter + ranking by our own historical
/// conversion. At a 74.5% rejection rate this is the only feature in the
/// module that raises revenue rather than tidying data.
/// scopeId = PLATFORM rows act as defaults inheritable by tenants.
model PipelineFinancier {
  id        String    @id @default(cuid())
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id")
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")

  supportedFinancing   FinancingType[] @map("supported_financing")
  supportedClientTypes ClientType[]    @map("supported_client_types")
  minAmountGrosze      Int?            @map("min_amount_grosze")
  maxAmountGrosze      Int?            @map("max_amount_grosze")
  minPeriodMonths      Int?            @map("min_period_months")
  maxPeriodMonths      Int?            @map("max_period_months")
  maxVehicleAgeYears   Int?            @map("max_vehicle_age_years")
  minBusinessAgeMonths Int?            @map("min_business_age_months")
  /// Structured extra criteria, evaluated by the recommender. Documented in
  /// docs/pipeline/EVENTS.md §Financier criteria.
  eligibilityRules     Json?           @map("eligibility_rules")
  defaultCommissionPct Decimal?        @map("default_commission_pct") @db.Decimal(6, 3)
  typicalDecisionDays  Int?            @map("typical_decision_days")
  notes                String?

  applicationEmailTo   String[]        @default([]) @map("application_email_to")
  applicationEmailCc   String[]        @default([]) @map("application_email_cc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications         PipelineApplication[]
  documentRequirements PipelineDocumentRequirement[]

  @@unique([scopeType, scopeId, code])
  @@index([scopeType, scopeId, isActive])
  @@map("pipeline_financiers")
}

// ---------- Financing application ----------

/// Owned by the opportunity, NOT by the offer. A reroute after a rejection
/// frequently changes financier AND vehicle; binding attempts to a single
/// offer breaks the attempt sequence and loses the recovery story.
model PipelineApplication {
  id                String                   @id @default(cuid())
  opportunityId     String                   @map("opportunity_id")
  offerId           String?                  @map("offer_id")
  financierId       String                   @map("financier_id")
  roundNumber       Int                      @map("round_number")
  externalReference String?                  @map("external_reference")
  state             PipelineApplicationState @default(DRAFT)

  submittedFirstAt DateTime? @map("submitted_first_at")
  submittedFullAt  DateTime? @map("submitted_full_at")
  decisionAt       DateTime? @map("decision_at")

  rejectionReasonCode  String? @map("rejection_reason_code")
  rejectionComment     String? @map("rejection_comment")
  withdrawalReasonCode String? @map("withdrawal_reason_code")
  approvedConditions   Json?   @map("approved_conditions")
  /// Set when this attempt was created by rerouting a previous rejection.
  rerouteFromId       String? @map("reroute_from_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunity                PipelineOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  offer                      PipelineOffer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  financier                  PipelineFinancier     @relation(fields: [financierId], references: [id])
  rerouteFrom                PipelineApplication?  @relation("Reroute", fields: [rerouteFromId], references: [id])
  rerouteTo                  PipelineApplication[] @relation("Reroute")
  rejectionReason            PipelineLossReason?   @relation(fields: [rejectionReasonCode], references: [code])
  commissions                PipelineCommission[]
  contractedForOpportunities PipelineOpportunity[] @relation("ContractedApplication")

  @@unique([opportunityId, financierId, roundNumber])
  @@index([financierId, state])
  @@index([opportunityId])
  @@map("pipeline_applications")
}

// ---------- Dictionaries & workflow configuration ----------

/// Closed dictionary. Free-text loss reasons were filled in 51% of the time in
/// the spreadsheet and produced 7 uncategorizable comments.
model PipelineLossReason {
  code            String  @id
  label           String
  category        String // "FINANCIER" | "CUSTOMER" | "QUALIFICATION"
  requiresComment Boolean @default(false) @map("requires_comment")
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")

  opportunities PipelineOpportunity[]
  applications  PipelineApplication[]

  @@map("pipeline_loss_reasons")
}

/// Stage gating as data, not as seven hand-written definition files.
/// A new product path is rows here, not a code change.
model PipelinePhaseRequirement {
  id            String         @id @default(cuid())
  scopeType     ScopeType      @map("scope_type")
  scopeId       String         @map("scope_id")
  code          String
  clientType    ClientType?    @map("client_type")
  financingType FinancingType? @map("financing_type")
  targetPhase   PipelinePhase  @map("target_phase")
  /// Dot path evaluated against the opportunity aggregate,
  /// e.g. "offer.monthlyRateGrosze", "customer.companyNip".
  fieldPath     String         @map("field_path")
  label         String
  /// HARD blocks the transition (HTTP 422). SOFT only shows on the
  /// completeness bar. Default SOFT — hard gates only where the data is
  /// needed for reporting, or advisors will type garbage to move the card.
  enforcement   String         @default("SOFT")
  sortOrder     Int            @default(0) @map("sort_order")
  isActive      Boolean        @default(true) @map("is_active")

  @@unique([scopeType, scopeId, code])
  @@index([scopeType, scopeId, targetPhase])
  @@map("pipeline_phase_requirements")
}

model PipelineDocumentRequirement {
  id            String         @id @default(cuid())
  scopeType     ScopeType      @map("scope_type")
  scopeId       String         @map("scope_id")
  code          String
  label         String
  clientType    ClientType?    @map("client_type")
  financingType FinancingType? @map("financing_type")
  financierId   String?        @map("financier_id")
  isMandatory   Boolean        @default(true) @map("is_mandatory")
  sortOrder     Int            @default(0) @map("sort_order")

  financier PipelineFinancier? @relation(fields: [financierId], references: [id], onDelete: Cascade)
  documents PipelineDocument[]

  @@unique([scopeType, scopeId, code, clientType, financingType, financierId])
  @@map("pipeline_document_requirements")
}

/// Tracks the STATUS of a document, never the file and never its content.
/// "Missing customer documents" is a top controllable loss reason; this turns
/// it into a task list with dates while storing zero personal data.
model PipelineDocument {
  id            String                 @id @default(cuid())
  opportunityId String                 @map("opportunity_id")
  requirementId String?                @map("requirement_id")
  code          String
  label         String
  status        PipelineDocumentStatus @default(REQUIRED)
  requestedAt   DateTime?              @map("requested_at")
  receivedAt    DateTime?              @map("received_at")
  verifiedAt    DateTime?              @map("verified_at")
  note          String?

  opportunity PipelineOpportunity          @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  requirement PipelineDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@unique([opportunityId, code])
  @@index([opportunityId, status])
  @@map("pipeline_documents")
}

// ---------- Tasks & commission ----------

model PipelineTask {
  id             String    @id @default(cuid())
  opportunityId  String    @map("opportunity_id")
  title          String
  kind           String    @default("MANUAL")
  dueAt          DateTime? @map("due_at")
  assignedUserId String?   @map("assigned_user_id")
  completedAt    DateTime? @map("completed_at")
  completedBy    String?   @map("completed_by")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  opportunity PipelineOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    User?               @relation("PipelineTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([assignedUserId, completedAt])
  @@index([opportunityId])
  @@index([dueAt])
  @@map("pipeline_tasks")
}

/// Amount is DERIVED from basis × rate. Manual entry is an override that must
/// carry a reason — this is what stops the spreadsheet pathology where 36% of
/// booked commission sat on deals that had no contract.
model PipelineCommission {
  id               String           @id @default(cuid())
  opportunityId    String           @map("opportunity_id")
  applicationId    String?          @map("application_id")
  status           CommissionStatus @default(EXPECTED)
  basisGrosze      Int              @map("basis_grosze")
  ratePct          Decimal          @map("rate_pct") @db.Decimal(6, 3)
  amountGrosze     Int              @map("amount_grosze")
  isManualOverride Boolean          @default(false) @map("is_manual_override")
  overrideReason   String?          @map("override_reason")
  invoiceNumber    String?          @map("invoice_number")
  earnedAt         DateTime?        @map("earned_at")
  paidAt           DateTime?        @map("paid_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  opportunity PipelineOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application PipelineApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([status])
  @@map("pipeline_commissions")
}

// ---------- Event log (append-only) & automation ----------

/// The case history. Append-only: a Postgres trigger rejects UPDATE (except
/// dispatchedAt) and DELETE — see migration `pipeline_events_immutable`.
///
/// This is NOT event sourcing. State tables above remain the read model and the
/// source of truth; the log is an audit trail plus an automation outbox, always
/// written INSIDE the same transaction as the state change it describes.
/// Rule: no state write without a recordEvent() call in the same transaction.
///
/// opportunityId and customerId are denormalized roll-up keys so that both
/// "everything that happened on this case" and "everything that happened with
/// this client, across cases" are one indexed query.
model PipelineEvent {
  id        String    @id @default(cuid())
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id")

  opportunityId String? @map("opportunity_id")
  customerId    String? @map("customer_id")
  aggregateType String  @map("aggregate_type")
  aggregateId   String  @map("aggregate_id")

  type        String
  actorType   PipelineActorType @map("actor_type")
  actorUserId String?           @map("actor_user_id")
  actorLabel  String?           @map("actor_label")
  /// { before?, after?, ... } — shape per event type, see docs/pipeline/EVENTS.md
  payload     Json

  occurredAt DateTime @default(now()) @map("occurred_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  correlationId    String?   @map("correlation_id")
  causationEventId String?   @map("causation_event_id")
  /// Set for events ingested from outside (Thulium replays, webhook retries).
  idempotencyKey   String?   @unique @map("idempotency_key")
  /// Outbox marker. NULL = not yet seen by the automation worker. The only
  /// column the immutability trigger permits updating.
  dispatchedAt     DateTime? @map("dispatched_at")

  opportunity PipelineOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer    PipelineCustomer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([opportunityId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([dispatchedAt])
  @@index([scopeType, scopeId, type, occurredAt])
  @@map("pipeline_events")
}

model PipelineAutomationRule {
  id          String    @id @default(cuid())
  scopeType   ScopeType @map("scope_type")
  scopeId     String    @map("scope_id")
  code        String
  name        String
  isActive    Boolean   @default(true) @map("is_active")
  /// Event type this rule subscribes to, or "SCHEDULE" for time-based rules.
  triggerType String    @map("trigger_type")
  /// JSON predicate over the event payload / opportunity aggregate.
  condition   Json?
  /// Ordered list of actions: CREATE_TASK | SET_NEXT_ACTION | NOTIFY |
  /// SET_COMMISSION_STATUS | EMIT_ANALYTICS | SEND_SMS
  actions     Json
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId, code])
  @@index([triggerType, isActive])
  @@map("pipeline_automation_rules")
}

model PipelineNumberSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("pipeline_number_sequences")
}

// ---------- Thulium dead letters ----------

/// Thulium notifications that could not be linked to any opportunity/customer
/// (or that failed payload validation). Never dropped silently — reviewed and
/// dismissed manually. Lives in the platform scope: an unmatched notification
/// does not belong to any dealer.
model PipelineThuliumDeadLetter {
  id        String    @id @default(cuid())
  scopeType ScopeType @map("scope_type")
  scopeId   String    @map("scope_id")

  action String
  reason String
  payload Json

  /// Ostatnie 4 cyfry numeru, jeśli payload go niósł — do szybkiego rozpoznania bez wyciągania pełnego numeru na listę.
  phoneSuffix String? @map("phone_suffix")

  receivedAt DateTime @default(now()) @map("received_at")

  dismissedAt     DateTime? @map("dismissed_at")
  dismissedUserId String?   @map("dismissed_user_id")

  @@index([scopeType, scopeId, dismissedAt])
  @@index([receivedAt])
  @@map("pipeline_thulium_dead_letters")
}

// <<< PIPELINE MODULE

// ===========================================================================
// MODUŁ PROGRAMU PRACOWNICZEGO (Employee Program by Motolia)
// ===========================================================================

enum EmployeeOfferSourceType {
  FINANCING // Nowe auto z tabeli Listing
  RENTAL    // Auto powiązane przez VehicleRentalAssignment
}

enum ContractPartyOption {
  CONSUMER          // Osoba fizyczna (konsument)
  EMPLOYEE_B2B      // Działalność gospodarcza pracownika
  EMPLOYER_COMPANY  // Firma pracodawcy (np. Action)
}

enum ProductAvailabilityStatus {
  AVAILABLE               // Potwierdzona dostępność
  REQUIRES_CONFIRMATION   // Wymaga potwierdzenia (domyślny przy braku weryfikacji)
  UNAVAILABLE             // Niedostępne dla danej formy umowy
}

enum MatrixPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model EmployeeCompany {
  id                String                     @id @default(cuid())
  name              String                     @unique
  slug              String                     @unique
  nip               String?
  isActive          Boolean                    @default(true) @map("is_active")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  programs          EmployeeProgram[]
  registrationCodes EmployeeRegistrationCode[]
  memberships       EmployeeMembership[]
  inquiries         EmployeeInquiry[]

  @@map("employee_companies")
}

model EmployeeProgram {
  id                   String                     @id @default(cuid())
  companyId            String                     @map("company_id")
  name                 String
  slug                 String                     @unique
  description          String?
  isActive             Boolean                    @default(true) @map("is_active")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  defaultDiscountPct   Decimal?                   @map("default_discount_pct") @db.Decimal(5, 2)

  company              EmployeeCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productOverrides     EmployeeProductOverride[]
  offers               EmployeeProgramOffer[]
  benefitPolicies      EmployeeBenefitPolicy[]
  memberships          EmployeeMembership[]
  inquiries            EmployeeInquiry[]
  registrationCodes    EmployeeRegistrationCode[]

  @@unique([companyId, id])
  @@map("employee_programs")
}

// Konfiguracja dopuszczonych produktów finansowych per program
model EmployeeProductOverride {
  id                      String                    @id @default(cuid())
  programId               String                    @map("program_id")
  financingProductId      String                    @map("financing_product_id")
  isEnabled               Boolean                   @default(true) @map("is_enabled")
  b2cStatus               ProductAvailabilityStatus @default(REQUIRES_CONFIRMATION) @map("b2c_status")
  allowedContractParties  ContractPartyOption[]     @default([EMPLOYEE_B2B, EMPLOYER_COMPANY]) @map("allowed_contract_parties")
  minDownPaymentPct       Decimal?                  @map("min_down_payment_pct") @db.Decimal(5, 2)
  maxDownPaymentPct       Decimal?                  @map("max_down_payment_pct") @db.Decimal(5, 2)
  allowedPeriods          Int[]                     @default([]) @map("allowed_periods") // Pusta tablica = dziedziczenie z Motolii
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  program                 EmployeeProgram           @relation(fields: [programId], references: [id], onDelete: Cascade)
  financingProduct        FinancingProduct          @relation(fields: [financingProductId], references: [id], onDelete: Restrict)

  @@unique([programId, financingProductId])
  @@map("employee_product_overrides")
}

model EmployeeRegistrationCode {
  id          String          @id @default(cuid())
  companyId   String          @map("company_id")
  programId   String          @map("program_id")
  codeHash    String          @unique @map("code_hash")
  label       String?
  isActive    Boolean         @default(true) @map("is_active")
  expiresAt   DateTime?       @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company     EmployeeCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  program     EmployeeProgram @relation(fields: [companyId, programId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("employee_registration_codes")
}

model EmployeeAccount {
  id              String                    @id @default(cuid())
  email           String                    @unique
  passwordHash    String                    @map("password_hash")
  firstName       String?                   @map("first_name")
  lastName        String?                   @map("last_name")
  phone           String?
  isActive        Boolean                   @default(true) @map("is_active")
  lastLoginAt     DateTime?                 @map("last_login_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  membership      EmployeeMembership?       // MVP: dokładnie jedno aktywne członkostwo
  membershipAudit EmployeeMembershipAudit[]
  inquiries       EmployeeInquiry[]

  @@map("employee_accounts")
}

model EmployeeMembership {
  id         String          @id @default(cuid())
  accountId  String          @unique @map("account_id") // 1 konto = 1 aktywne członkostwo w MVP
  companyId  String          @map("company_id")
  programId  String          @map("program_id")
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")
  revokedAt  DateTime?       @map("revoked_at")

  account    EmployeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company    EmployeeCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  program    EmployeeProgram @relation(fields: [companyId, programId], references: [companyId, id], onDelete: Restrict)

  @@map("employee_memberships")
}

model EmployeeMembershipAudit {
  id         String          @id @default(cuid())
  accountId  String          @map("account_id")
  companyId  String          @map("company_id")
  programId  String          @map("program_id")
  action     String          @map("action") // CREATED, ROTATED, REVOKED, REINSTATED
  reason     String?         @map("reason")
  createdAt  DateTime        @default(now()) @map("created_at")

  account    EmployeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("employee_membership_audits")
}

// Prywatne matryce najmu - powiązane z dostawcą floty RentalCompany
model EmployeeMatrixSet {
  id                     String                    @id @default(cuid())
  rentalCompanyId        String                    @map("rental_company_id")
  name                   String                    // np. "Ayvens Flota Zamknięta"
  description            String?
  allowedContractParties ContractPartyOption[]     @default([EMPLOYEE_B2B, EMPLOYER_COMPANY]) @map("allowed_contract_parties")
  b2cStatus              ProductAvailabilityStatus @default(REQUIRES_CONFIRMATION) @map("b2c_status")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  rentalCompany          RentalCompany             @relation(fields: [rentalCompanyId], references: [id], onDelete: Restrict)
  versions               EmployeeMatrixVersion[]

  @@map("employee_matrix_sets")
}

model EmployeeMatrixVersion {
  id            String                 @id @default(cuid())
  matrixSetId   String                 @map("matrix_set_id")
  versionNumber Int                    @map("version_number")
  label         String                 // np. "Zestaw 6% fee - Q3 2026"
  feePct        Decimal?               @map("fee_pct") @db.Decimal(5, 2)
  status        MatrixPublishStatus    @default(DRAFT)
  publishedAt   DateTime?              @map("published_at")
  effectiveFrom DateTime?              @map("effective_from")
  effectiveTo   DateTime?              @map("effective_to")
  createdAt     DateTime               @default(now()) @map("created_at")

  matrixSet     EmployeeMatrixSet      @relation(fields: [matrixSetId], references: [id], onDelete: Cascade)
  rows          EmployeeMatrixRow[]
  offers        EmployeeProgramOffer[]

  @@unique([matrixSetId, versionNumber])
  @@map("employee_matrix_versions")
}

model EmployeeMatrixRow {
  id                      String                  @id @default(cuid())
  versionId               String                  @map("version_id")
  assignmentId            String                  @map("assignment_id") // Powiązanie z pojazdem i dostawcą
  contractMonths          Int                     @map("contract_months")
  annualMileageKm         Int                     @map("annual_mileage_km")
  initialPaymentPct       Decimal                 @map("initial_payment_pct") @db.Decimal(5, 2)
  initialPaymentAmountNet Decimal                 @default(0) @map("initial_payment_amount_net") @db.Decimal(10, 2)
  monthlyRateNet          Decimal                 @map("monthly_rate_net") @db.Decimal(10, 2)
  monthlyRateGross        Decimal                 @map("monthly_rate_gross") @db.Decimal(10, 2)
  servicesIncluded        String[]                @default([]) @map("services_included")
  insuranceExcess500      Decimal?                @map("insurance_excess_500") @db.Decimal(10, 2)
  insuranceNoLimit        Decimal?                @map("insurance_no_limit") @db.Decimal(10, 2)
  tiresNoLimit            Decimal?                @map("tires_no_limit") @db.Decimal(10, 2)
  overMileageCost         Decimal?                @map("over_mileage_cost") @db.Decimal(6, 4)
  createdAt               DateTime                @default(now()) @map("created_at")

  version                 EmployeeMatrixVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  assignment              VehicleRentalAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  // Kompletny klucz unikalności wiersza kalkulacji:
  @@unique([versionId, assignmentId, contractMonths, annualMileageKm, initialPaymentPct, initialPaymentAmountNet])
  @@index([versionId, assignmentId])
  @@map("employee_matrix_rows")
}

// Oferty w programie: powiązane z Listing (finansowanie) lub VehicleRentalAssignment (najem)
model EmployeeProgramOffer {
  id              String                   @id @default(cuid())
  programId       String                   @map("program_id")
  sourceType      EmployeeOfferSourceType  @map("source_type")

  listingId       String?                  @map("listing_id")
  listing         Listing?                 @relation(fields: [listingId], references: [id], onDelete: Restrict)

  assignmentId    String?                  @map("assignment_id")
  assignment      VehicleRentalAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  matrixVersionId String?                  @map("matrix_version_id")
  matrixVersion   EmployeeMatrixVersion?   @relation(fields: [matrixVersionId], references: [id], onDelete: Restrict)

  customPricePln  Int?                     @map("custom_price_pln")
  discountPct     Decimal?                 @map("discount_pct") @db.Decimal(5, 2)

  benefitPolicyId String?                  @map("benefit_policy_id")
  benefitPolicy   EmployeeBenefitPolicy?   @relation(fields: [programId, benefitPolicyId], references: [programId, id], onDelete: Restrict)

  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  program         EmployeeProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Unikalności: dokładnie 1 oferta danego auta w finansowaniu i 1 oferta danego przypisania dostawcy w najmie:
  @@unique([programId, listingId])
  @@unique([programId, assignmentId])
  @@index([programId, isActive])
  @@map("employee_program_offers")
}

model EmployeeBenefitPolicy {
  id              String                 @id @default(cuid())
  programId       String                 @map("program_id")
  name            String                 // np. "Pakiet Start Moya 500"
  moyaCardAmount  Int?                   @map("moya_card_amount")
  fuelDiscount    String?                @map("fuel_discount")
  consultantCare  Boolean                @default(true) @map("consultant_care")
  termsText       String?                @map("terms_text")
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  program         EmployeeProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  offers          EmployeeProgramOffer[]

  @@unique([programId, id])
  @@map("employee_benefit_policies")
}

model EmployeeInquiry {
  id                       String                    @id @default(cuid())
  accountId                String                    @map("account_id")
  companyId                String                    @map("company_id")
  programId                String                    @map("program_id")
  contractParty            ContractPartyOption       @map("contract_party")
  productAvailabilityStatus ProductAvailabilityStatus @default(REQUIRES_CONFIRMATION) @map("product_availability_status")

  contactName              String                    @map("contact_name")
  contactEmail             String                    @map("contact_email")
  contactPhone             String                    @map("contact_phone")
  nip                      String?
  notes                    String?

  calculationSnapshot      Json                      @map("calculation_snapshot")
  benefitSnapshot          Json?                     @map("benefit_snapshot")

  idempotencyKey           String                    @unique @map("idempotency_key")
  leadId                   String?                   @unique @map("lead_id")
  lead                     Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  status                   String                    @default("NEW")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  account                  EmployeeAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  company                  EmployeeCompany           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  program                  EmployeeProgram           @relation(fields: [companyId, programId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([accountId])
  @@map("employee_inquiries")
}
