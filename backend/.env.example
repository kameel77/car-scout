# Database
DATABASE_URL="postgresql://carscout_user:your_password_here@localhost:5432/carscout"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Analytics
ANALYTICS_DEFAULT_DAYS=30
ANALYTICS_MAX_DAYS=365
ANALYTICS_CACHE_TTL=300

# Thulium webhook (required for POST /api/pipeline/integrations/thulium/webhook)
THULIUM_WEBHOOK_SECRET=""

# Cloudflare Edge Cache Purge (optional - used in production/staging)
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
